// Generated by Noctalia from the active palette. Do not edit by hand:
// the file is rewritten whenever the theme changes.
//
// Pulled in by `include "noctalia.kdl"` at the end of config.kdl, so these
// values win over anything set earlier in the main file.
layout {
    border {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline_variant.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }
}
