input {
    keyboard {
        repeat-delay 500
        repeat-rate 25
    }

    touchpad {
        tap
        drag false
        natural-scroll
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }

    // Focus windows and outputs automatically when moving the mouse into them.
    // Setting max-scroll-amount="0%" makes it work only on windows already fully on screen.
    focus-follows-mouse max-scroll-amount="0%"

    disable-power-key-handling
}

output "eDP-1" {
    mode "3072x1920@165.002"
    scale 2
    transform "normal"
    position x=0 y=0
    max-bpc 12

    variable-refresh-rate
}

layout {
    gaps 2
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }

    border {
        width 1.2
        // colours come from Noctalia: include "noctalia.kdl" at the end of this file
    }
}


hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path null

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open a Terminal: Ghostty" { spawn-sh "$TERMINAL"; }
    Mod hotkey-overlay-title="Toggle Shell Launcher" {
        release { spawn-sh "noctalia msg panel-toggle launcher"; }
    }

    Mod+L hotkey-overlay-title="Lock the Screen" { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+L allow-when-locked=true { spawn-sh "noctalia msg session lock; systemctl suspend"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "noctalia msg media pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "noctalia msg media next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    Mod+Alt+Left  { move-column-left; }
    Mod+Alt+Down  { move-window-down; }
    Mod+Alt+Up    { move-window-up; }
    Mod+Alt+Right { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Alt+Home { move-column-to-first; }
    Mod+Alt+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    Mod+Shift+Alt+Left  { move-window-to-monitor-left; }
    Mod+Shift+Alt+Down  { move-window-to-monitor-down; }
    Mod+Shift+Alt+Up    { move-window-to-monitor-up; }
    Mod+Shift+Alt+Right { move-window-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Alt+Page_Down { move-column-to-workspace-down; }
    Mod+Alt+Page_Up   { move-column-to-workspace-up; }

    Mod+Ctrl+Down { move-workspace-down; }
    Mod+Ctrl+Up   { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+TouchpadScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+TouchpadScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Alt+WheelScrollDown cooldown-ms=150 { move-window-to-workspace-down; }
    Mod+Alt+WheelScrollUp   cooldown-ms=150 { move-window-to-workspace-up; }
    Mod+Alt+TouchpadScrollDown      cooldown-ms=150 { move-window-to-workspace-down; }
    Mod+Alt+TouchpadScrollUp        cooldown-ms=150 { move-window-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+TouchpadScrollRight  cooldown-ms=150 { focus-column-right; }
    Mod+TouchpadScrollLeft      cooldown-ms=150 { focus-column-left; }


    Mod+Alt+WheelScrollRight { move-column-right; }
    Mod+Alt+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Alt+Shift+WheelScrollDown { move-column-right; }
    Mod+Alt+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Alt+1 { move-window-to-workspace 1 focus=false; }
    Mod+Alt+2 { move-window-to-workspace 2 focus=false; }
    Mod+Alt+3 { move-window-to-workspace 3 focus=false; }
    Mod+Alt+4 { move-window-to-workspace 4 focus=false; }
    Mod+Alt+5 { move-window-to-workspace 5 focus=false; }
    Mod+Alt+6 { move-window-to-workspace 6 focus=false; }
    Mod+Alt+7 { move-window-to-workspace 7 focus=false; }
    Mod+Alt+8 { move-window-to-workspace 8 focus=false; }
    Mod+Alt+9 { move-window-to-workspace 9 focus=false; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Minus  { consume-window-into-column; }
    Mod+Equal { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Alt+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+Alt+F { expand-column-to-available-width; }

    Mod+Shift+C { center-column; }

    Mod+Alt+C { center-visible-columns; }

    Mod+Semicolon { set-column-width "-10%"; }
    Mod+Apostrophe { set-column-width "+10%"; }

    Mod+Shift+Semicolon { set-window-height "-10%"; }
    Mod+Shift+Apostrophe { set-window-height "+10%"; }

    Mod+Alt+Space     { toggle-window-floating; }
    Mod+Shift+Space { switch-focus-between-floating-and-tiling; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }

    XF86PowerOff { spawn-sh "noctalia msg panel-toggle session"; }

    Mod+V { spawn-sh "noctalia msg panel-toggle clipboard"; }

    Mod+Period { spawn-sh "noctalia msg panel-toggle launcher /emo"; }

    Mod+B { spawn-sh "noctalia msg panel-toggle control-center"; }


    Mod+M { spawn-sh "noctalia msg media toggle"; }

    Ctrl+Alt+Delete { spawn-sh "noctalia msg panel-toggle session"; }

    Mod+J { spawn-sh "noctalia msg bar-toggle"; }

    Mod+Alt+M { spawn-sh "noctalia msg mic-mute"; }

    Mod+E { spawn "dolphin"; }

    Mod+W { spawn "firefox"; }

    Mod+C { spawn "code"; }

    Mod+X { spawn "kwrite"; }

    Mod+I { spawn-sh "noctalia msg settings-toggle || systemsettings"; }

    Mod+Shift+P { spawn-sh "noctalia msg media toggle"; }
    Mod+Shift+N { spawn-sh "noctalia msg media next"; }
    Mod+Shift+B { spawn-sh "noctalia msg media previous"; }

    Mod+Shift+S { spawn-sh "noctalia msg plugin pulsar/screen-shot-and-record:ipc all screenshot"; }


    Ctrl+Shift+Escape { spawn-sh "plasma-systemmonitor --page-name 应用程序"; }

    Ctrl+Mod+R allow-when-locked=true { spawn-sh "pkill -f '/bin/noctalia$'; while pgrep -f '/bin/noctalia$' >/dev/null; do sleep 0.1; done; setsid -f noctalia >/dev/null 2>&1"; }

    Ctrl+Mod+Alt+R allow-when-locked=true { spawn-sh "hyprlock"; }

    Mod+P { power-off-monitors; }
}

spawn-sh-at-startup "sleep 1 && dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"
spawn-at-startup "noctalia"
spawn-sh-at-startup "gnome-keyring-daemon --start --components=secrets"
spawn-sh-at-startup "dbus-update-activation-environment --all"
spawn-sh-at-startup "/run/current-system/sw/libexec/pam_kwallet_init"
spawn-sh-at-startup "kwalletd6"
spawn-sh-at-startup "xrdb ~/.Xresources"

spawn-sh-at-startup "timeout 10 bash -c 'while ! noctalia msg session lock; do sleep 0.1; done'"

spawn-sh-at-startup "systemd-inhibit --who='Niri config' --why='Handle power key in Niri' --what=handle-power-key --mode=block sleep infinity & echo $! > /tmp/.niri-systemd-inhibit"

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    draw-border-with-background false
    /* Apps: blur them all without xray for a better look */
    opacity 0.95
    background-effect {
      blur true
      xray false
    }
}

// Noctalia 设置窗口：悬浮、居中，横纵各占工作区 80%
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { proportion 0.8; }
    default-window-height { proportion 0.8; }
}

clipboard {
    disable-primary
}

// from noctalia docs
debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

// Noctalia's blurred backdrop layer inside the niri overview
// (requires [backdrop] enabled = true in the Noctalia config).
layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}


/* Noctalia: blur everywhere without xray for a better look */
layer-rule {
  match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"
  background-effect {
    xray false
  }
}

blur {
  passes 2        // more passes = stronger blur (default: 3)
  offset 3.0      // sample distance per pass (default: 3.0)
  noise 0.03      // grain overlay (default: 0.02)
  saturation 1.0  // color saturation boost (default: 1.5)
}

// Disable the hot corners.
gestures {
    hot-corners {
        off
    }
}

switch-events {
    lid-close { spawn "noctalia" "msg" "session" "lock"; }
}


// XWayland
window-rule {
    match app-id="^$" title="^$"

    background-effect {
        blur false
    }
}

// 文件选择器 / 另存为 / 上传等对话框：居中浮动
window-rule {
    match title=r#"^(Open File)(.*)$"#
    match title=r#"^(Select a File)(.*)$"#
    match title=r#"^(Choose wallpaper)(.*)$"#
    match title=r#"^(Open Folder)(.*)$"#
    match title=r#"^(Save As)(.*)$"#
    match title=r#"^(Library)(.*)$"#
    match title=r#"^(File Upload)(.*)$"#
    match title=r#"^(.*)(wants to save)$"#
    match title=r#"^(.*)(wants to open)$"#

    open-floating true
}

// KWrite
window-rule {
    match title=r#"^(保存文件)(.*)$"# app-id="org.kde.kwrite"
    match title=r#"^(打开文件)(.*)$"# app-id="org.kde.kwrite"

    open-floating true
    default-column-width { proportion 0.6; }
    default-window-height { proportion 0.65; }
}

// blueberry.py
window-rule {
    match app-id=r#"^(blueberry\.py)$"#

    open-floating true
}

// guifetch
window-rule {
    match app-id="^(guifetch)$"

    open-floating true
}

// pavucontrol（含两种变体）以及 pavucontrol-qt
window-rule {
    match app-id="^(pavucontrol)$"
    match app-id="^(org.pulseaudio.pavucontrol)$"
    match app-id="^(pavucontrol-qt)$"

    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.45; }
}

// nm-connection-editor
window-rule {
    match app-id="^(nm-connection-editor)$"

    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.45; }
}

// plasma windowed
window-rule {
    match app-id=".*plasmawindowed.*"

    open-floating true
}

// kcm_*（KDE 配置模块）
window-rule {
    match app-id="kcm_.*"

    open-floating true
}

// bluedevilwizard
window-rule {
    match app-id=".*bluedevilwizard"

    open-floating true
}

// Welcome 窗口
window-rule {
    match title=".*Welcome"

    open-floating true
}

// Shell conflicts
window-rule {
    match title=".*Shell conflicts.*"

    open-floating true
}

// KDE portal
window-rule {
    match app-id="org.freedesktop.impl.portal.desktop.kde"

    open-floating true
    default-column-width { proportion 0.60; }
    default-window-height { proportion 0.65; }
}

// Zotero
window-rule {
    match app-id="^(Zotero)$"

    open-floating true
    default-column-width { proportion 0.45; }
    default-window-height { proportion 0.45; }
}

// plasma-changeicons
window-rule {
    match app-id="^(plasma-changeicons)$"

    open-floating true
    open-focused false
}

// Warp 终端：强制平铺，覆盖任何自动浮动逻辑
window-rule {
    match app-id="^dev\\.warp\\.Warp$"

    open-floating false
}

window-rule {
    match title=r#"^([Pp]icture[\-s]?[Ii]n[\-s]?[Pp]icture)(.*)$"#
    match title="^画中画$"

    open-floating true
    default-column-width { proportion 0.25; }
    default-window-height { proportion 0.25; }

    default-floating-position x=32 y=32 relative-to="bottom-right"
}

window-rule {
    match title="^SPlayer - 桌面歌词$"

    open-floating true

    background-effect {
      blur false
      xray false
    }
    border {
        off
    }
}

window-rule {
    match title="^SPlayer-Next - Desktop Lyric$"

    open-floating true

    background-effect {
      blur false
      xray false
    }
    border {
        off
    }
}

// JetBrains IDE 焦点/重绘问题
window-rule {
    match app-id=r#"^jetbrains-.*$"# title=r#"^$|^\s$|^win\d+$"#

    open-floating true
    open-focused false
}

cursor {
    xcursor-theme "BenBen"
    xcursor-size 32
}

// cursor {
//     xcursor-theme "macOS"
//     xcursor-size 24
// }


environment {
    ELECTRON_OZONE_PLATFORM_HINT "1"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "kde"
    XDG_MENU_PREFIX "plasma-"

    LANG "zh_CN.UTF-8"
    LC_ALL "zh_CN.UTF-8"


    TERMINAL "kitty"

    // XCURSOR_SIZE "24"
    GDK_DPI_SCALE "1"
    // QT_AUTO_SCREEN_SCALE_FACTOR "0"

    QT_IM_MODULE "fcitx"
    GTK_IM_MODULE null
    XMODIFIERS "@im=fcitx"
    SDL_IM_MODULE "fcitx"
    GLFW_IM_MODULE "ibus"
}

/*
  Noctalia
  Disable xray on all our surfaces so it looks more realistic.
  Noctalia publishes blur regions automatically when ext-background-effects is available.
*/
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    // blur false
  }
}

/* Enable blur on noctalia's window switcher and disable xray. */
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// Noctalia 的配色主题
include "noctalia.kdl"
